          "find": "            t  = a->coeffs[8 * i + j];\n            // t += ((int16_t)t >> 15) & KYBER_Q;\n            // t  = (((t << 1) + KYBER_Q/2)/KYBER_Q) & 1;\n            t <<= 1;\n            t += 1665;\n            t *= 80635;\n            t >>= 28;\n            t &= 1;",
          "replace": "            {\n                static uint8_t lut[65536]; static int ready;\n                if (!ready) {\n                    for (uint32_t v = 0; v < 65536; v++) {\n                        uint32_t u = (uint32_t)(int32_t)(int16_t)v;\n                        lut[v] = (uint8_t)((((u << 1) + 1665) * 80635 >> 28) & 1);\n                    }\n                    ready = 1;\n                }\n                t = lut[(uint16_t)a->coeffs[8 * i + j]];\n            }",
