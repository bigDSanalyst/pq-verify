      "commit": "fc269bc2d1068486625a3775310c2c1f28d74732",
      "date": "2026-09-27",
      "build": "mlkem-native",
      "sets": [
        "ML-KEM-512",
        "ML-KEM-768",
        "ML-KEM-1024"
      ],
      "expected": {
